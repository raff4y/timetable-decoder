# Copy to .env.local (git-ignored) for local dev; set the same names in Vercel
# (Project -> Settings -> Environment Variables). Never commit real values.

# Neon Postgres connection string (Neon console -> Connect). Pooled one is fine.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth base URL (Neon console -> your project -> Auth -> Configuration).
# Looks like https://ep-xxxx.neonauth.region.aws.neon.build/neondb/auth
# The server verifies JWTs against <this>/.well-known/jwks.json, issuer = its origin.
NEON_AUTH_URL=
# Same value, exposed to the browser bundle by Vite.
VITE_NEON_AUTH_URL=

# Optional: comma-separated emails promoted to admin by `npm run seed:users`.
ADMIN_EMAILS=

# Optional overrides (normally leave unset):
# NEON_AUTH_JWKS_URL=      # default <NEON_AUTH_URL>/.well-known/jwks.json
# NEON_AUTH_ISSUER=        # default origin of NEON_AUTH_URL
# APP_ORIGIN=https://your-app.vercel.app   # extra origins allowed as password-reset redirect targets
# API_PORT=8787            # local API dev server port (Vite proxies /api to it)
# TRUST_PROXY=1           # only behind a reverse proxy that overwrites X-Forwarded-For
#                          # (automatic on Vercel); otherwise IPs for rate limits are spoofable
